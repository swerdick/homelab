  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Per-host worst-of: stale telemetry >15m (red; note: hosts share the nightly power cycle — a just-woken fleet clears within minutes), disk >90% (yellow), SMART failure (red). Source: host Alloy job integrations/unix.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "autoSizeColumns": true,
        "autoSizePolygons": true,
        "autoSizeRows": true,
        "compositeConfig": {
          "animationSpeed": "500",
          "composites": [],
          "enabled": false
        },
        "ellipseCharacters": 18,
        "ellipseEnabled": false,
        "globalAutoScaleFonts": true,
        "globalClickthrough": "",
        "globalClickthroughNewTabEnabled": false,
        "globalDecimals": 0,
        "globalDisplayMode": "all",
        "globalDisplayTextTriggeredEmpty": "OK",
        "globalFillColor": "#299c46",
        "globalOperator": "current",
        "globalShape": "hexagon_pointed_top",
        "globalShowValueEnabled": false,
        "globalStat": "current",
        "globalTextFontAutoColorEnabled": true,
        "globalThresholdsConfig": [
          {
            "color": "#299c46",
            "state": 0,
            "value": 0
          },
          {
            "color": "#EAB839",
            "state": 1,
            "value": 1
          },
          {
            "color": "#d44a3a",
            "state": 2,
            "value": 2
          }
        ],
        "globalTooltipsEnabled": true,
        "globalUnitFormat": "none",
        "overrideConfig": {
          "overrides": []
        },
        "sortByDirection": 1,
        "sortByField": "name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (instance) (label_replace(((time() - last_over_time(timestamp(up{job=\"integrations/unix\"})[2d:5m])) > bool 900) * 2, \"sig\", \"stale\", \"\", \"\") or label_replace(max by (instance) ((1 - node_filesystem_avail_bytes{job=\"integrations/unix\",fstype=~\"ext4|xfs|zfs|btrfs|vfat\"} / node_filesystem_size_bytes) > bool 0.90), \"sig\", \"disk\", \"\", \"\") or label_replace(max by (instance) ((smartctl_device_smart_status == bool 0) * 2), \"sig\", \"smart\", \"\", \"\") or label_replace(max by (instance) (up{job=\"integrations/unix\"} * 0), \"sig\", \"base\", \"\", \"\"))",
          "instant": false,
          "legendFormat": "{{instance}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Hosts — worst status (green 0 / yellow 1 / red 2)",
      "type": "grafana-polystat-panel"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Per-namespace worst-of: unavailable replicas (red), recent OOMKill (red), CrashLoop/ImagePull waiting (red), any restart in 24h (yellow), Pending pods (yellow — comfyui Pending during gaming cordons is expected).",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "autoSizeColumns": true,
        "autoSizePolygons": true,
        "autoSizeRows": true,
        "compositeConfig": {
          "animationSpeed": "500",
          "composites": [],
          "enabled": false
        },
        "ellipseCharacters": 18,
        "ellipseEnabled": false,
        "globalAutoScaleFonts": true,
        "globalClickthrough": "",
        "globalClickthroughNewTabEnabled": false,
        "globalDecimals": 0,
        "globalDisplayMode": "all",
        "globalDisplayTextTriggeredEmpty": "OK",
        "globalFillColor": "#299c46",
        "globalOperator": "current",
        "globalShape": "hexagon_pointed_top",
        "globalShowValueEnabled": false,
        "globalStat": "current",
        "globalTextFontAutoColorEnabled": true,
        "globalThresholdsConfig": [
          {
            "color": "#299c46",
            "state": 0,
            "value": 0
          },
          {
            "color": "#EAB839",
            "state": 1,
            "value": 1
          },
          {
            "color": "#d44a3a",
            "state": 2,
            "value": 2
          }
        ],
        "globalTooltipsEnabled": true,
        "globalUnitFormat": "none",
        "overrideConfig": {
          "overrides": []
        },
        "sortByDirection": 1,
        "sortByField": "name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (namespace) (label_replace(max by (namespace) ((kube_deployment_status_replicas_unavailable > bool 0) * 2), \"sig\",\"unavail\",\"\",\"\") or label_replace(max by (namespace) (clamp_max(increase(kube_pod_container_status_restarts_total[24h]), 1)), \"sig\",\"restarts\",\"\",\"\") or label_replace(max by (namespace) (kube_pod_container_status_waiting_reason{reason=~\"CrashLoopBackOff|ImagePullBackOff|ErrImagePull|CreateContainerConfigError|CreateContainerError\"} * 2), \"sig\",\"waiting\",\"\",\"\") or label_replace(max by (namespace) (kube_pod_status_phase{phase=\"Pending\"}), \"sig\",\"pending\",\"\",\"\") or label_replace(max by (namespace) ((kube_pod_container_status_last_terminated_reason{reason=\"OOMKilled\"} and on(namespace, pod) (increase(kube_pod_container_status_restarts_total[24h]) > 0)) * 2), \"sig\",\"oom\",\"\",\"\") or label_replace(clamp_max(max by (namespace) (kube_pod_status_phase{phase=\"Running\"}), 1) * 0, \"sig\",\"base\",\"\",\"\"))",
          "instant": false,
          "legendFormat": "{{namespace}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Workloads by namespace — worst status",
      "type": "grafana-polystat-panel"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
